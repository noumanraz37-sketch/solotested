---
layout: base.njk
permalink: /articles/
title: All articles
description: Every SoloTested guide, newest first. Filter by topic or search by keyword.
---
{%- from "macros.njk" import card -%}
<div class="wrap">
  <div class="pagehead"><h1>All articles</h1><p>Every guide we have published, newest first. Filter by topic or search.</p></div>
  <div class="filters" id="filters">
    <button class="on" data-f="All">All</button>{% for c in categories %}{% if (collections.feed | byCategory(c.name)).length %}<button data-f="{{ c.name }}">{{ c.name }}</button>{% endif %}{% endfor %}
  </div>
  {% if collections.feed.length %}
  <div class="grid g4" id="all">{% for p in collections.feed %}<div class="item" data-cat="{{ p.data.category }}" data-text="{{ (p.data.title + ' ' + p.data.meta_description + ' ' + (p.data.primary_keyword or '')) | lower }}" style="display:contents">{{ card(p) }}</div>{% endfor %}</div>
  <p id="none" class="empty" hidden>No articles match that search yet.</p>
  {% else %}<div class="empty">The first guides are on their way.</div>{% endif %}
</div>
<script>
(function(){
  var f='All',q=(new URLSearchParams(location.search).get('q')||'').toLowerCase();
  var box=document.querySelector('.search input');if(box&&q)box.value=q;
  function run(){var n=0;document.querySelectorAll('#all .item').forEach(function(it){var ok=(f==='All'||it.dataset.cat===f)&&(!q||it.dataset.text.indexOf(q)>-1);it.style.display=ok?'contents':'none';if(ok)n++;});var e=document.getElementById('none');if(e)e.hidden=n>0;}
  document.getElementById('filters').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;f=b.dataset.f;document.querySelectorAll('#filters button').forEach(function(x){x.classList.toggle('on',x===b)});run();});
  if(box)box.addEventListener('input',function(){q=box.value.toLowerCase();run();});
  run();document.querySelectorAll('#all .card').forEach(function(c){c.classList.add('in')});
})();
</script>
